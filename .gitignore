# Agentic Workbench .gitignore

# ============================================================================
# Model Files (VERY LARGE - do not commit)
# ============================================================================
*.gguf
*.bin
*.safetensors
*.pt
*.pth
data/models/
!data/models/.gitkeep

# ============================================================================
# Data Files (potentially large)
# ============================================================================
# Raw data dumps
data/raw/
!data/raw/.gitkeep

# Processed data
data/processed/*.parquet
data/processed/*.csv
data/processed/*.json
data/processed/*.jsonl
!data/processed/.gitkeep

# Indexes (can be rebuilt)
data/indexes/
!data/indexes/.gitkeep

# ============================================================================
# Run Outputs (generated files)
# ============================================================================
# Run logs
runs/logs/*.jsonl
runs/logs/**/*.jsonl

# Traces
runs/traces/
!runs/traces/.gitkeep

# Reports
runs/reports/*.html
runs/reports/*.md
runs/reports/**/*
!runs/reports/.gitkeep

# Metrics database
runs/metrics/*.sqlite
runs/metrics/*.db
!runs/metrics/.gitkeep

# Keep directory structure but ignore contents
runs/**/
!runs/**/.gitkeep

# ============================================================================
# Phoenix / Observability
# ============================================================================
# Phoenix database
phoenix.db
.phoenix/

# ============================================================================
# Python
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.toml

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ============================================================================
# IDEs
# ============================================================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*~
*.swp
*.swo
.*.sw?

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# Operating Systems
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*
.nfs*

# ============================================================================
# Project Specific
# ============================================================================
# Temporary files
tmp/
temp/
*.tmp

# Downloaded files (can be re-downloaded)
downloads/

# Backup files
*.bak
*.backup
*~

# Config overrides (keep defaults only)
configs/*_local.yaml
configs/*_override.yaml
configs/secrets.yaml

# Experiment artifacts
experiments/
scratch/

# ============================================================================
# Keep Directory Structure
# ============================================================================
# This ensures empty directories stay in git
!.gitkeep

# ============================================================================
# Notes
# ============================================================================
# Add personal notes here that shouldn't be committed
NOTES.txt
TODO.txt
*_NOTES.md

# ============================================================================
# Specific Large Files (examples)
# ============================================================================
# Add specific large files or patterns here
# Example: 
# data/wikipedia_dump.xml
# data/large_dataset.csv