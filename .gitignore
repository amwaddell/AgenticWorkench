# ============================================================================
# Agentic Workbench .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# LARGE MODEL FILES (DO NOT COMMIT) - These are 4-5GB+ each!
# ----------------------------------------------------------------------------
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

# Model directories
data/models/
models/
checkpoints/

# ----------------------------------------------------------------------------
# DATA DIRECTORIES (DO NOT COMMIT) - Can be large and regenerated
# ----------------------------------------------------------------------------
data/raw/
data/processed/
data/indexes/
data/embeddings/

# Keep directory structure but ignore contents
!data/.gitkeep
!data/models/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/indexes/.gitkeep

# ----------------------------------------------------------------------------
# RUN OUTPUTS (DO NOT COMMIT) - Generated per run
# ----------------------------------------------------------------------------
runs/
*.log
*.jsonl

# Metrics database
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# ----------------------------------------------------------------------------
# PYTHON
# ----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ----------------------------------------------------------------------------
# VIRTUAL ENVIRONMENTS
# ----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.virtualenv/

# ----------------------------------------------------------------------------
# JUPYTER NOTEBOOK
# ----------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Jupyter Notebook config
.jupyter/

# ----------------------------------------------------------------------------
# IDEs & EDITORS
# ----------------------------------------------------------------------------
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ----------------------------------------------------------------------------
# OPERATING SYSTEM
# ----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ----------------------------------------------------------------------------
# OBSERVABILITY & MONITORING
# ----------------------------------------------------------------------------
# Phoenix
.phoenix/

# OpenTelemetry
.otel/

# ----------------------------------------------------------------------------
# TEMPORARY FILES
# ----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig

# ----------------------------------------------------------------------------
# SECRETS & CREDENTIALS (IMPORTANT!)
# ----------------------------------------------------------------------------
*.key
*.pem
*.env
.env.local
.env.*.local
secrets/
credentials/
*.secret

# ----------------------------------------------------------------------------
# PROJECT SPECIFIC
# ----------------------------------------------------------------------------
# Downloaded datasets
*.zip
*.tar.gz
*.tar.bz2
*.7z

# Large text dumps
*.xml.bz2
*.json.gz

# Cached embeddings
*.npy
*.npz
*.pkl
*.pickle

# Index files (can be large)
*.faiss
*.annoy

# ----------------------------------------------------------------------------
# KEEP THESE FILES (Override above patterns)
# ----------------------------------------------------------------------------
# Keep example small models for testing (if any)
!tests/fixtures/*.gguf

# Keep documentation
!*.md
!docs/

# Keep config files
!configs/
!*.yaml
!*.yml
!*.toml

# Keep example data (small files only)
!examples/data/*.txt